    "中" : {

    },
    "技术说明" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical Details"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术说明"
          }
        }
      }
    },
    "• JPEG压缩算法基于离散余弦变换(DCT)和量化，文件大小与图像内容复杂度密切相关" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• The JPEG compression algorithm is based on Discrete Cosine Transform (DCT) and quantization; the file size is closely related to the complexity of the image content."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• JPEG压缩算法基于离散余弦变换(DCT)和量化，文件大小与图像内容复杂度密切相关"
          }
        }
      }
    },
    "• 相同质量参数下，纹理复杂的图像比简单图像占用更多空间" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• At the same quality setting, an image with rich texture consumes more space than a simple one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 相同质量参数下，纹理复杂的图像比简单图像占用更多空间"
          }
        }
      }
    },
    "• 系统采用二分搜索算法在±10KB容差范围内寻找最优质量参数" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• The system uses a binary-search algorithm to find the optimal quality parameter within a ±10 KB tolerance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 系统采用二分搜索算法在±10KB容差范围内寻找最优质量参数"
          }
        }
      }
    }
  },
  "version" : "1.1"
